// Tournament Score & Pairing System — data model
// See tournament_score_pairing_uxui_spec_v2.md for the requirements this schema encodes.
// Key rule (spec §8, §20): Maximum Score lives on Round, NEVER as a single Tournament-level value.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  USER
}

enum StaffStatus {
  INVITED // added by an Admin, waiting for the person to accept (no access yet)
  ACTIVE
  DECLINED // the person turned the invite down
  REVOKED
}

enum TournamentMode {
  COMPETITION
  PRACTICE
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum PlayerStatus {
  ACTIVE
  WITHDRAWN
}

enum PairingMethod {
  RANDOM
  SWISS
  KING_OF_THE_HILL
  ROUND_ROBIN
}

enum RoundStatus {
  DRAFT // not generated yet
  PREVIEW // generated, awaiting confirm
  CONFIRMED // pairing locked, matches in progress
  COMPLETED // all matches confirmed
}

enum MatchStatus {
  PENDING // no score submitted yet
  SUBMITTED // one side submitted
  CONFLICT // both submitted but disagree
  CONFIRMED // both sides agree, or admin finalized
  BYE // no opponent, auto-confirmed
}

enum MatchOutcome {
  WIN
  TIE
  LOSS
}

enum LinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // dev/mock credential login; Phase 3 adds Google OAuth alongside this
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  globalPlayer        GlobalPlayer?
  staffAssignments    TournamentStaff[]
  createdTournaments  Tournament[]       @relation("TournamentCreatedBy")
  linkRequestsMade    LinkRequest[]      @relation("LinkRequestUser")
  linkRequestsHandled LinkRequest[]      @relation("LinkRequestReviewer")
  editedMatches       Match[]            @relation("MatchEditedByAdmin")
  auditLogs           AuditLog[]
  refereeCallsHandled RefereeCall[]
  presence            StaffPresence[]
  staffInvitesSent    TournamentStaff[]  @relation("StaffInvitedBy")
  notifications       UserNotification[]
}

// Global Player ID — stable identity for a player across every tournament (spec §1).
// A plain sequential number (not a cuid) so it reads as the human-facing ID it is.
model GlobalPlayer {
  // Random 6-digit ID (100000-999999), assigned in application code — see
  // src/lib/global-player-id.ts. Not autoincrement, so it never reads as a plain sequence.
  id        Int      @id
  name      String
  nickname  String?
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  tournamentPlayers TournamentPlayer[]
  linkRequests      LinkRequest[]
}

// Approval workflow for binding a Google account to a Global Player (spec §4).
model LinkRequest {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation("LinkRequestUser", fields: [userId], references: [id])
  globalPlayerId Int
  globalPlayer   GlobalPlayer      @relation(fields: [globalPlayerId], references: [id])
  status         LinkRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?             @relation("LinkRequestReviewer", fields: [reviewedById], references: [id])
  createdAt      DateTime          @default(now())
  reviewedAt     DateTime?

  @@index([status])
}

model Tournament {
  id     String           @id @default(cuid())
  name   String
  mode   TournamentMode   @default(COMPETITION)
  status TournamentStatus @default(UPCOMING)

  // Player-count and game-count limits are independent toggles (spec §7) — never merge them.
  setPlayerLimit   Boolean @default(true)
  maxPlayers       Int?
  setNumberOfGames Boolean @default(true)
  numberOfGames    Int?

  // First/Second is opt-in per tournament (spec §11).
  useFirstSecond Boolean @default(true)

  // Only a *default* seed for new Games — never a Tournament-wide cap (spec §8, §20).
  defaultMaximumScore Int? @default(350)

  // Practice-mode-only, optional soft privacy gate for the public /t/[id] pages — a random
  // code so casual visitors can't browse someone else's practice history. Never set for
  // COMPETITION (enforced in createTournament); Admin/Staff with access always bypass it.
  pinCode String?

  // Practice-mode-only, tournament-wide link/QR for self-service ad-hoc scoring — lets a
  // player log a game with no staff-created Round at all. Generated unconditionally for
  // every PRACTICE tournament (no opt-out, unlike pinCode). Never set for COMPETITION.
  // Distinct from TournamentTable.qrToken, which is per-table and only resolves while a
  // staff-run Round is CONFIRMED.
  selfServiceToken String? @unique

  createdById String
  createdBy   User     @relation("TournamentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff        TournamentStaff[]
  players      TournamentPlayer[]
  rounds       Round[]
  tables       TournamentTable[]
  matches      Match[]
  absences     RoundAbsence[]
  refereeCalls RefereeCall[]
  groups       TournamentGroup[]

  @@index([status])
}

// Staff ⇄ Tournament assignment (spec §5, §6, §20). Scope must be checked on every request.
model TournamentStaff {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  status       StaffStatus @default(ACTIVE)
  assignedAt   DateTime    @default(now())
  // Who sent the invite — told when it's accepted or declined.
  invitedById  String?
  invitedBy    User?       @relation("StaffInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  respondedAt  DateTime?

  notifications UserNotification[]

  @@unique([userId, tournamentId])
  @@index([tournamentId])
}

// Tournament Player ID — restarts at 1 for every tournament (spec §1).
model TournamentPlayer {
  id                 String           @id @default(cuid())
  tournamentId       String
  tournament         Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  globalPlayerId     Int
  globalPlayer       GlobalPlayer     @relation(fields: [globalPlayerId], references: [id])
  tournamentPlayerNo Int
  status             PlayerStatus     @default(ACTIVE)
  // Optional pairing group (e.g. ชาย / หญิง) — only matters to a Round with splitByGroup.
  groupId            String?
  group              TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  matchesAsPlayer1 Match[]        @relation("MatchPlayer1")
  matchesAsPlayer2 Match[]        @relation("MatchPlayer2")
  absences         RoundAbsence[]

  // W/T/L, cumulative score/diff and First/Second totals are ALWAYS derived from confirmed
  // Matches (spec §9.5) — intentionally not cached here to avoid a second source of truth.

  @@unique([tournamentId, tournamentPlayerNo])
  @@unique([tournamentId, globalPlayerId])
  @@index([tournamentId, status])
}

// A Round groups the Games/Matches played in one pairing cycle.
// Maximum Score is set here, per round — never Tournament-wide (spec §8, §10, §20).
model Round {
  id            String         @id @default(cuid())
  tournamentId  String
  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber   Int
  pairingMethod PairingMethod?

  maximumScoreEnabled Boolean @default(true)
  maximumScore        Int?    @default(350)

  // Paired within each TournamentGroup instead of across everyone — e.g. men and women play
  // among themselves for Games 1-4, then together from Game 5. Each group has its own method
  // (groupMethods) and pairingMethod stays null. The Scoreboard shows one table per group
  // while the latest Round is split (src/lib/scoreboard.ts).
  splitByGroup Boolean            @default(false)
  groupMethods RoundGroupMethod[]

  status      RoundStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  confirmedAt DateTime?

  matches  Match[]
  absences RoundAbsence[]

  @@unique([tournamentId, roundNumber])
}

// A per-tournament pairing group, named by Admin/Staff (ชาย / หญิง, ประถม / มัธยม, ...). Points
// and Diff are never kept per group — a group only decides who may be paired together in a
// split Round, and which players share a Scoreboard table while the split lasts.
model TournamentGroup {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())

  players      TournamentPlayer[]
  roundMethods RoundGroupMethod[]

  @@unique([tournamentId, name])
}

// The pairing method one group used in a split Round (Round.splitByGroup).
model RoundGroupMethod {
  roundId       String
  round         Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  groupId       String
  group         TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pairingMethod PairingMethod

  @@id([roundId, groupId])
}

// A player who was due to play this Round but never showed up. They're taken out of the
// Round's matches (the players left without an opponent are re-paired among themselves — see
// repairRoundForAbsences) and instead get a forfeit: L 0-100 (Diff -100), counted like any
// other result once the Round is CONFIRMED. Removing the row (they arrived after all) puts
// them back into the pairing pool.
model RoundAbsence {
  id                 String           @id @default(cuid())
  roundId            String
  round              Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // Denormalized (like Match.tournamentId) so Scoreboard/Standings can query by tournament.
  tournamentId       String
  tournament         Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentPlayerId String
  tournamentPlayer   TournamentPlayer @relation(fields: [tournamentPlayerId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([roundId, tournamentPlayerId])
  @@index([tournamentId])
}

// A physical table with a durable QR code, reused across the whole tournament (spec §12).
model TournamentTable {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tableNumber  Int
  qrToken      String     @unique @default(cuid())
  createdAt    DateTime   @default(now())

  matches      Match[]
  refereeCalls RefereeCall[]

  @@unique([tournamentId, tableNumber])
}

// One Game/Match between two Tournament Players (or a Bye) within a Round — or, for a
// Practice-mode self-service match, no Round at all (roundId null, spec: no staff action
// required).
model Match {
  id      String           @id @default(cuid())
  roundId String?
  round   Round?           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  tableId String?
  table   TournamentTable? @relation(fields: [tableId], references: [id])

  // Denormalized and ALWAYS required (unlike roundId) so Scoreboard/Standings can query
  // every Match — round-based or self-service ad-hoc — directly by tournament, without
  // joining through Round (which a self-service match doesn't have).
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  player1Id String
  // Required (unlike player2), so it can't fall back to SetNull — must cascade, otherwise a
  // completed match blocks deleting the Tournament that owns it.
  player1   TournamentPlayer  @relation("MatchPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id String? // null => Bye (spec §19)
  player2   TournamentPlayer? @relation("MatchPlayer2", fields: [player2Id], references: [id])
  isBye     Boolean           @default(false)

  // First/Second assignment for this game, only meaningful when Tournament.useFirstSecond (spec §11).
  firstPlayerId  String?
  secondPlayerId String?

  // Only populated for self-service ad-hoc matches (roundId null), frozen at creation time
  // from Tournament.defaultMaximumScore — mirrors what Round.maximumScoreEnabled/maximumScore
  // do for round-based matches, which have no need for these and keep reading from Round
  // unchanged. See src/lib/match/max-score-config.ts for the one place that picks between them.
  maximumScoreEnabled Boolean?
  maximumScore        Int?

  // Each side independently reports the full result (spec §13) — compared in submissions
  // below, never taken from a single side alone.
  submissions  MatchSubmission[]
  refereeCalls RefereeCall[]

  // Final, agreed-upon (or admin-resolved) values used for all downstream calculations.
  finalPlayer1Score Int?
  finalPlayer2Score Int?
  player1Result     MatchOutcome?
  player2Result     MatchOutcome?

  status MatchStatus @default(PENDING)

  // A player at the table reported "my opponent didn't show up". The table QR page has no
  // login, so a claim alone is never trusted — Admin/Staff approve it by marking the opponent
  // absent (RoundAbsence), which re-pairs the round. Cleared once the match gets a real result.
  byeClaimedById String?
  byeClaimedAt   DateTime?

  editedByAdminId String?
  editedByAdmin   User?   @relation("MatchEditedByAdmin", fields: [editedByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roundId])
  @@index([tournamentId])
  @@index([player1Id])
  @@index([player2Id])
}

enum MatchSide {
  PLAYER1
  PLAYER2
}

// Spec §13: neither side's self-reported score is trusted alone. Each side submits BOTH
// scores as they saw them; the two submissions are compared to auto-confirm or flag a
// Score Conflict. Resubmitting (upsert on matchId+side) overwrites the previous entry.
model MatchSubmission {
  id           String    @id @default(cuid())
  matchId      String
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side         MatchSide
  player1Score Int
  player2Score Int
  submittedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([matchId, side])
}

// Central trail of consequential Admin/Staff actions (add/remove Admin, assign/revoke Staff,
// delete/unlink a Player, delete a Tournament, override a match result, ...) — none of these
// previously left any record of who did it. Deliberately NOT for anonymous player score entry
// at /table or /practice/play, which already has its own trail via MatchSubmission
// (side/scores/timestamp per side) and has no logged-in actor to attribute to anyway.
model AuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  action     String // short machine-readable key, e.g. "player.delete", "admin.remove"
  summary    String // human-readable one-liner shown in the log UI
  targetType String? // e.g. "GlobalPlayer", "Tournament", "User", "Match"
  targetId   String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

enum RefereeCallStatus {
  OPEN // waiting for a referee to pick it up
  ACKNOWLEDGED // a referee is on the way
  RESOLVED // the referee handled it
  CANCELLED // withdrawn from the table before anyone came
}

// "Call a referee" from a table's QR page. Public like the rest of /table (no login at the
// table), so there's at most one OPEN/ACKNOWLEDGED call per table at a time — repeat taps
// don't pile up. Admin/Staff screens stream the open ones (src/app/api/referee-calls/stream).
model RefereeCall {
  id             String            @id @default(cuid())
  tournamentId   String
  tournament     Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tableId        String
  table          TournamentTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  // The match on the table when the call was made (or the one it just finished), for context.
  matchId        String?
  match          Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)
  status         RefereeCallStatus @default(OPEN)
  handledById    String?
  handledBy      User?             @relation(fields: [handledById], references: [id])
  createdAt      DateTime          @default(now())
  acknowledgedAt DateTime?
  closedAt       DateTime?

  @@index([status, tournamentId])
  @@index([tableId, status])
}

// "Who's on duty right now": one row per Admin/Staff device with the admin live stream open
// (src/app/api/referee-calls/stream), touched every ~30s while it stays open. Online = seen in
// the last 45s. Per device rather than per user, so "sound off" is only shown when every open
// screen of that person has the referee chime muted.
model StaffPresence {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Random id the browser keeps in localStorage — not a fingerprint, just "this screen".
  deviceId   String
  soundMuted Boolean  @default(false)
  lastSeenAt DateTime

  @@id([userId, deviceId])
  @@index([lastSeenAt])
}

enum NotificationKind {
  STAFF_INVITE // with accept / decline (see staffAssignment)
  STAFF_INVITE_ANSWERED // to the Admin who invited
  STAFF_REMOVED // an Admin took this person off a tournament's Staff
  LINK_APPROVED
  LINK_REJECTED
}

// In-app notifications for signed-in people (the user menu and the admin bell). Unlike the
// one-shot alerts (lib/flash.ts) these are stored, so they reach someone who wasn't looking
// when it happened — e.g. a Staff invite sent before the person ever signed in.
model UserNotification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind
  title  String
  body   String?
  // Where tapping it goes, when it isn't answered in place.
  href   String?

  staffAssignmentId String?
  staffAssignment   TournamentStaff? @relation(fields: [staffAssignmentId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// System-wide switches an Admin flips at /admin/settings (src/lib/system-settings.ts). One row,
// id 1, created on first save — until then every field reads as its default.
model SystemSetting {
  id              Int      @id @default(1)
  // The Admin/Staff live feed (src/app/api/referee-calls/stream): referee calls, table
  // results and "who's online". Off: no screen streams, and table pages hide "เรียกกรรมการ".
  liveFeedEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}
